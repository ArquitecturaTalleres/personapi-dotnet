@model personapi_dotnet.Models.Entities.Profesion
@{
    ViewData["Title"] = "Detalles de la Profesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="h4 mb-0">
                            <i class="fas fa-briefcase me-2"></i>@ViewData["Title"]
                        </h2>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i> Volver al listado
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="profesion-details">
                        <div class="detail-item mb-4">
                            <div class="detail-icon bg-primary text-white">
                                <i class="fas fa-id-badge"></i>
                            </div>
                            <div class="detail-content">
                                <h6>ID de Profesión</h6>
                                <p class="lead">@Model.Id</p>
                            </div>
                        </div>

                        <div class="detail-item mb-4">
                            <div class="detail-icon bg-info text-white">
                                <i class="fas fa-signature"></i>
                            </div>
                            <div class="detail-content">
                                <h6>Nombre</h6>
                                <p class="lead">@Model.Nom</p>
                            </div>
                        </div>

                        <div class="detail-item">
                            <div class="detail-icon bg-success text-white">
                                <i class="fas fa-align-left"></i>
                            </div>
                            <div class="detail-content">
                                <h6>Descripción</h6>
                                <p class="text-muted">@(string.IsNullOrEmpty(Model.Des) ? "No hay descripción disponible" : Model.Des)</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                            <i class="fas fa-edit me-2"></i> Editar
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-list me-2"></i> Ver todas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
            border: none;
        }
        .profesion-details {
            background-color: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1.5rem;
        }
        .detail-item {
            display: flex;
            align-items: flex-start;
            padding: 1rem 0;
        }
        .detail-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1.5rem;
            flex-shrink: 0;
        }
        .detail-content h6 {
            color: #6c757d;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }
        .detail-content p.lead {
            font-size: 1.1rem;
            margin-bottom: 0;
            color: #212529;
            font-weight: 500;
        }
        .detail-content p.text-muted {
            font-style: italic;
            white-space: pre-line;
        }
        .btn-primary {
            border-radius: 0.375rem;
            font-weight: 500;
        }
        .btn-outline-secondary {
            border-radius: 0.375rem;
            font-weight: 500;
        }
        .card-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
}