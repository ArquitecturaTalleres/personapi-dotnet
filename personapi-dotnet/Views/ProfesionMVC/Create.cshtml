@model personapi_dotnet.Models.Entities.Profesion
@{
    ViewData["Title"] = "Agregar Profesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h4 mb-0"><i class="fas fa-briefcase me-2"></i>@ViewData["Title"]</h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Id" class="form-control" placeholder=" " required />
                                    <label asp-for="Id"></label>
                                    <div class="invalid-feedback">
                                        Por favor ingrese el ID de la profesión
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Nom" class="form-control" placeholder=" " required />
                                    <label asp-for="Nom"></label>
                                    <div class="invalid-feedback">
                                        Por favor ingrese el nombre de la profesión
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <textarea asp-for="Des" class="form-control" placeholder=" "
                                              style="height: 120px"></textarea>
                                    <label asp-for="Des"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-arrow-left me-2"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-2"></i> Guardar Profesión
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        .card {
            border-radius: 10px;
            border: none;
        }
        .card-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .form-floating label {
            color: #6c757d;
            padding: 1rem 0.75rem;
        }
        .form-control, .form-select, textarea.form-control {
            border-radius: 8px;
            padding: 1rem 0.75rem;
        }
        .form-control:focus, textarea.form-control:focus {
            border-color: #28a745;
            box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.25);
        }
        .btn-success {
            background-color: #28a745;
            border: none;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-outline-secondary {
            border-radius: 8px;
            font-weight: 500;
        }
        .invalid-feedback {
            margin-top: 0.25rem;
            font-size: 0.875rem;
            color: #dc3545;
        }
    </style>
}

@section Scripts {
    <script>
        // Validación del lado del cliente
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}