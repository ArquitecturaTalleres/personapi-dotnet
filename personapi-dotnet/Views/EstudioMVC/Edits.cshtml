@model personapi_dotnet.Models.Entities.Estudio
@{
    ViewData["Title"] = "Editar Estudio";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h2>
        </div>

        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="IdProf" />
                <input type="hidden" asp-for="CcPer" />

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Fecha" class="form-control" type="date" required />
                            <label asp-for="Fecha"></label>
                            <div class="invalid-feedback">
                                Por favor ingrese una fecha válida
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Univer" class="form-control" required />
                            <label asp-for="Univer"></label>
                            <div class="invalid-feedback">
                                Por favor ingrese el nombre de la universidad
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        .card {
            border-radius: 10px;
            border: none;
        }
        .card-header {
            font-weight: 600;
        }
        .form-floating label {
            color: #6c757d;
            padding: 1rem 0.75rem;
        }
        .form-control {
            border-radius: 8px;
            padding: 12px;
            height: calc(3.5rem + 2px);
        }
        .btn-primary {
            background-color: #4e73df;
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            font-weight: 500;
        }
        .btn-outline-secondary {
            border-radius: 8px;
            padding: 10px 24px;
            font-weight: 500;
        }
        .invalid-feedback {
            margin-top: 5px;
            font-size: 0.85rem;
        }
    </style>
}

@section Scripts {
    <script>
        // Validación del lado del cliente
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}