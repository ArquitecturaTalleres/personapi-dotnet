@model personapi_dotnet.Models.Entities.Estudio
@{
    ViewData["Title"] = "Agregar Estudio";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-graduation-cap mr-2"></i>@ViewData["Title"]</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <select asp-for="CcPer" class="form-select" asp-items="@(new SelectList(ViewBag.Personas, "Cc", "Nombre"))" required>
                                <option value="">Seleccione una persona</option>
                            </select>
                            <label asp-for="CcPer" class="form-label">Persona</label>
                            <div class="invalid-feedback">
                                Por favor seleccione una persona
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <select asp-for="IdProf" class="form-select" asp-items="@(new SelectList(ViewBag.Profesiones, "Id", "Nom"))" required>
                                <option value="">Seleccione una profesión</option>
                            </select>
                            <label asp-for="IdProf" class="form-label">Profesión</label>
                            <div class="invalid-feedback">
                                Por favor seleccione una profesión
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input asp-for="Fecha" class="form-control" type="date" required />
                            <label asp-for="Fecha" class="form-label"></label>
                            <div class="invalid-feedback">
                                Por favor ingrese una fecha válida
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input asp-for="Univer" class="form-control" placeholder=" " required />
                            <label asp-for="Univer" class="form-label"></label>
                            <div class="invalid-feedback">
                                Por favor ingrese la universidad
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                        <i class="fas fa-arrow-left mr-1"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i> Guardar Estudio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        .card {
            border-radius: 10px;
            border: none;
        }
        .form-control, .form-select {
            border-radius: 8px;
            padding: 12px;
        }
        .form-floating label {
            padding: 1rem 0.75rem;
        }
        .btn-primary {
            background-color: #4e73df;
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
        }
        .btn-outline-secondary {
            border-radius: 8px;
            padding: 10px 20px;
        }
    </style>
}

@section Scripts {
    <script>
        // Validación del lado del cliente
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}